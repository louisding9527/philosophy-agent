# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会提交

# LLM 服务（中转站，走 Anthropic Messages 协议）
LLM_API_KEY=sk-你的key
# 中转站地址，例如 https://opencode.ai/zen/go/v1
LLM_BASE_URL=
# anthropic 或 openai（默认 anthropic，对应 /v1/messages 接口）
LLM_PROVIDER=anthropic
# 默认模型，可用模型见中转站 /v1/models 列表
LLM_MODEL=deepseek-v4-flash

# 本地向量化模型（sentence-transformers），首次使用自动从 HuggingFace 下载；
# 追求小体积可用 paraphrase-multilingual-MiniLM-L12-v2（384 维，需同步改集合配置）
EMBEDDING_MODEL=BAAI/bge-m3
# 向量化设备：auto（有 AMD/NVIDIA GPU 用 DirectML，否则 CPU）| dml | cpu
EMBEDDING_DEVICE=auto

# 入库记录表（同步驱动 psycopg）；密码需与 docker/.env 的 POSTGRES_PASSWORD 一致
# 用 127.0.0.1 而非 localhost：本机 localhost 会优先解析到 ::1（IPv6 未映射会挂起）
# 例如: postgresql://philosophy:你的密码@127.0.0.1:5432/philosophy
DATABASE_URL=

# Qdrant 向量库地址，例如: http://localhost:6333
QDRANT_URL=

# Neo4j 地址，例如: bolt://localhost:7687
NEO4J_URI=
