# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不会提交

# LLM 服务（中转站，走 Anthropic Messages 协议）
LLM_API_KEY=sk-你的key
# 中转站地址，例如 https://opencode.ai/zen/go/v1
LLM_BASE_URL=
# anthropic 或 openai（默认 anthropic，对应 /v1/messages 接口）
LLM_PROVIDER=anthropic
# 默认模型，可用模型见中转站 /v1/models 列表
LLM_MODEL=deepseek-v4-flash

# 例如: postgresql+asyncpg://user:pass@localhost:5432/philosophy
DATABASE_URL=

# Qdrant 向量库地址，例如: http://localhost:6333
QDRANT_URL=

# Neo4j 地址，例如: bolt://localhost:7687
NEO4J_URI=
